# ============================================================
# MeterSerial-VLM  |  Environment Configuration
# ============================================================

# Server settings
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info

# Allowed CORS origins (comma-separated list, or '*' for all)
CORS_ORIGINS=*

# Default OCR / VLM backend ('paddleocr', 'lightonocr', or 'qwen2_vl')
DEFAULT_MODEL=paddleocr

# Green LED detection threshold (percentage of green pixels in display, default: 1.0)
GREEN_LIGHT_THRESHOLD=1.0

# OpenMP runtime conflict prevention (keep TRUE when mixing PyTorch & PaddlePaddle)
KMP_DUPLICATE_LIB_OK=TRUE

# Disable PaddleX online model source checking for offline/fast startup
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Optional Hugging Face configuration for downloading VLM weights
HF_TOKEN=
HF_HOME=model_store